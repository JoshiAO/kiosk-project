rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Basic security for the kiosk app:
    // Requires authentication (either Custom Token from device, or Email/Pass for dashboard).
    
    match /devices/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    match /config/{document=**} {
      allow read: if request.auth != null;
      // Admin dashboard can write to config if needed
      allow write: if request.auth != null;
    }
    
    match /approved_apps/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
